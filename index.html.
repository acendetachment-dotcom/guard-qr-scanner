
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Guard Tour QR Scanner</title>

  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      margin: 0;
      padding: 18px;
      color: #1e293b;
    }

    .container {
      max-width: 550px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 10px #0002;
    }

    h2 {
      text-align: center;
      color: #176b45;
    }

    #reader {
      width: 100%;
      margin-top: 18px;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 14px;
      border: none;
      border-radius: 7px;
      background: #176b45;
      color: white;
      font-size: 16px;
      font-weight: bold;
    }

    .stop {
      background: #b91c1c;
    }

    #message {
      margin-top: 18px;
      padding: 12px;
      background: #f1f5f9;
      border-radius: 7px;
      overflow-wrap: anywhere;
      text-align: center;
    }

    .note {
      font-size: 13px;
      color: #64748b;
      text-align: center;
    }
  </style>
</head>

<body>
  <div class="container">

    <h2>GUARD TOUR QR SCANNER</h2>

    <p class="note">
      Point your cellphone camera at the existing Guard Tour QR code.
    </p>

    <div id="reader"></div>

    <button id="startButton" onclick="startScanner()">
      START CAMERA
    </button>

    <button id="stopButton" class="stop"
      onclick="stopScanner()" hidden>
      STOP CAMERA
    </button>

    <div id="message">
      Scanner ready. Press START CAMERA.
    </div>

  </div>

  <script>
    let scanner = null;
    let running = false;
    let scanned = false;

    async function startScanner() {
      const message = document.getElementById("message");

      if (typeof Html5Qrcode === "undefined") {
        message.textContent =
          "Scanner library failed to load. Check your internet connection.";
        return;
      }

      if (running) return;

      scanned = false;

      try {
        scanner = new Html5Qrcode("reader");

        message.textContent =
          "Requesting camera access. Please allow permission.";

        await scanner.start(
          { facingMode: "environment" },
          {
            fps: 10,
            qrbox: { width: 250, height: 250 }
          },
          function(decodedText) {
            if (scanned) return;

            scanned = true;

            message.textContent =
              "QR CODE SCANNED SUCCESSFULLY!";

            sendResult(decodedText);
          }
        );

        running = true;

        document.getElementById("startButton").hidden = true;
        document.getElementById("stopButton").hidden = false;

        message.textContent =
          "Camera active. Scan your checkpoint QR code.";

      } catch (error) {
        running = false;

        message.textContent =
          "CAMERA ERROR: " + error;
      }
    }

    async function stopScanner() {
      if (scanner && running) {
        try {
          await scanner.stop();
          await scanner.clear();
        } catch (error) {
          console.log(error);
        }
      }

      running = false;

      document.getElementById("startButton").hidden = false;
      document.getElementById("stopButton").hidden = true;
    }

    async function sendResult(qrText) {
      await stopScanner();

      const message = document.getElementById("message");

      if (window.opener && !window.opener.closed) {
        window.opener.postMessage(
          {
            type: "GUARD_QR_SCANNED",
            qrText: qrText
          },
          "*"
        );

        message.textContent =
          "QR result sent to Guard Tour Dashboard. You may close this page.";

      } else {
        message.textContent =
          "QR scanned, but Guard Dashboard was not detected. Please reopen the scanner from your dashboard.";
      }
    }
  </script>
</body>
</html>
